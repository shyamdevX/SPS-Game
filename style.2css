/* Start Btn */
#startBtn, #restBtn{
  flex: 1;
  max-width: 500px;
  padding: 15px 25px;
  border-radius: 10px;
  /* font-size: 1.2rem; */
  font-weight: 600;
  text-align: center;
  cursor: pointer;
  background: rgba(0, 0, 0, 0.18);
  backdrop-filter: blur(14px);
  transition: all 0.2s ease;
}
#startBtn{
  color: #fff;
  border: 1.5px solid #00d9ff;
  /* padding: 15px 50px; */
  box-shadow: 0 0 12px rgba(0, 229, 255, 0.35);
  /* text-shadow: 0 0 8px rgba(0, 217, 255, 0.8); */
}
#startBtn:hover{
  background: rgba(0, 229, 255, 0.10);
  box-shadow: 0 0 22px rgba(0, 217, 255, 0.439);
  transform: translateY(-2px) scale(1.03);
}

/* Restart Btn */
#resetBtn{
  color: #aaa;
  border: 1.5px solid rgba(255, 255, 255, 0.15);
  /* box-shadow: none;
  padding: 15px 50px; */
}
#resetBtn:hover{
  color: #fff;
  border: 1.5px solid #ff4bd8;
   box-shadow: 0 0 12px rgba(0, 75, 216, 0.08);
   /* text-shadow: 0 0 8px rgba(255, 75, 216, 0.6); */
}
/* #resetBtn:not(.hidden):hover{
  background: rgba(255, 75, 216, 0.1);
  box-shadow: 0 0 22px rgba(255, 75, 216, 0.5);
  transform: translateY(-2px) scale(1.03);
}
.main-btn:active{
  transform: scale(0.96);
} */
.hidden{
  display: none !important;
  opacity: 0.4;
  pointer-events: none; 
}
@media(max-width:480px){
  .buttons{
    flex-direction: column;
  }
  #startBtn, #resetBtn{
    max-width: 100%;
  }
}
