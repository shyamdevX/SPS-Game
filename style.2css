/* Choices of Game */
.Choices{
  width: 100%;
  margin-top: 18px;
  display: flex;
  justify-content: center;
  /* align-items: center; */
  padding: 40px 30px 28px;
  gap: clamp(25px, 7vw, 75px);
  /* background: rgba(0,0,0,0.75); */
  backdrop-filter: blur(5px);

  border-bottom: none;
  /* -webkit-backdrop-filter: blur(14px); */
  border: 1px solid rgba(255, 255, 255, .25);
  border-radius: 18px 18px 0 0 ;
    box-shadow: 0 0 20px rgba(255, 0, 190, .22);
}
.choice{
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8px;
  opacity: 0.50;
  /* cursor: not-allowed;
  transition: all 0.35s ease; */

}
/* .Choices.active .choice{
  opacity: 1;
  cursor: pointer;
} */
/* .choice:hover{
  transform: translateY(-6px) scale(1.06);
}

.choice:active{
  transform: scale(0.93);
} */
.choice img{
  width: clamp(90px, 12vw, 150px);
  height: clamp(90px, 22vw, 150px);
  border-radius: 50%;
  border: 3px solid;
  object-fit: cover;
  /* background: rgba(10, 15, 35, .6); */
}
.choice span {
  font-size: 15px;
  font-weight: 600;
  letter-spacing: 2px;
  
}

#rock img{
  /* border-color: #ff4bd8; */
  border: 4px solid #ff4bd8;
  box-shadow: 0 0 12px #ff4bd8;
  cursor: pointer;
  transition: all 0.3s ease;
  
}

#paper img{
  border: 4px solid #a94cff;
  box-shadow: 0 0 12px violet;
  cursor: pointer;
  transition: all 0.3s ease;

}
#scissors img{
  border: 4px solid #66a7ff;
  box-shadow: 0 0 12px #66a7ff;
  cursor: pointer;
  transition: all 0.3s ease;
}

#rock img:hover, #paper img:hover, #scissors img:hover{
  opacity: 1;
   box-shadow: 0 0 22px rgba(0, 217, 255, 0.6);
   transform: translateY(-2px) scale(1.03);
   
} 
