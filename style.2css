/* Score Card */
.score-card{
  width: 100%;
  min-width: 300px;
  display: flex;
  justify-content: space-between;
  
  align-items: center;
  padding: 18px 55px;
  background: rgba(10, 12, 30, .6);
  /* backdrop-filter: blur(12px); */
   
  border-left: 2px solid rgba(255, 255, 255, .25);
  border-right: 2px solid rgba(255, 255, 255, .25);
  
}
.score{
  min-width: 170px;
  background: rgba(10, 12, 30, .6);
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 0 22px #d778ff;
  border-radius: 10px;
  /* backdrop-filter: blur(15px);
  -webkit-backdrop-filter: blur(15px); */
  /* text-align: center;
  color: #fff; */
}
#user-score, #comp-score{
  font-size: 1.8rem;
  font-weight: 700;
  line-height: 1.5;
  color: #fff;
  text-shadow: 0 0 10px #fff;
}
.score small{
  font-size: 1.2rem;
  color: #ccc;
  letter-spacing: 2px;
  /* font-size: 2rem; */
  font-weight: 600;
  margin-top: 5px;
}
.score p::before{
  content: "VS"; 
  position: absolute; 
   left: 48.6%; 
  /* transform: translateX(-50px); */
  color: #d778ff;
  font-weight: 800;
  font-size: 2rem;
  display: flex;
  margin-top: 12px;
 justify-content: center;
  text-shadow: 0 0 12px #a83cff;
}

/* Message Box */
.msg-container{
  width: 100%;
  background: rgba(15, 20, 45, .55);
  backdrop-filter: blur(14px);
  -webkit-backdrop-filter: blur(14px);
  border:  2px solid rgba(255, 255, 255, .25);
  /* border-right:  2px solid rgba(255, 0, 255, 0.3);
  border-bottom:  2px solid rgba(255, 0, 255, 0.3); */
  border-top: none;
  border-radius: 0 0 20px 20px;
  padding: 20px;
  /* text-align: center; */
  min-height: 70px;
  display: flex;
  align-items: center;
  justify-content: center;
}

#msg{
  display: inline-block;
  background: rgba(42, 146, 73, 0.92);
  border: 2px solid #2ecc71;
  margin: 25px;
  padding: 7px 18px;
  border-radius: 22px;
  font-size: 12px;
  font-weight: 700;
  text-align: center;
  color: #fff;
  opacity: 0;
  transform: translateY(12px) scale(0.92);
  transition: all 0.5s ease;
  box-shadow: 0 0 14px rgba(60, 255, 90, .18);
}
.msg-show{
  opacity: 1;
  transform: translateY(0) scale(1);
}

/* Buttons */
.buttons{
  display: flex;
  justify-content: center;
  gap: 15px;
  margin-top: 25px;
  /* background: transparent !important; */
  /* padding: 30px;  */
}
.buttons button{
  width: 300px;
  padding: 15px;
  border-radius: 10px;
  font-size: 1.5rem;
  font-weight: bold;
  cursor: pointer;
  transition: all 3s ease;
}
